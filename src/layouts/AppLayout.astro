---
const {
  title = 'Cortex · Astro Rebuild',
  description = 'Rediseño Astro del generador Cortex con audio reactivo, timeline y luz estroboscópica.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
