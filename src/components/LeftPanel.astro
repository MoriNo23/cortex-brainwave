<aside class="panel panel-left">
  <div class="section">
    <div class="section-title">Presets <span class="hint">click para aplicar</span></div>
    <div class="presets" id="presets">
      <div class="preset" data-preset-id="builtin-delta" data-band="delta" data-freq="2">
        <span class="preset-icon">🌙</span><span class="preset-name">Delta</span>
      </div>
      <div class="preset" data-preset-id="builtin-theta" data-band="theta" data-freq="6">
        <span class="preset-icon">🌀</span><span class="preset-name">Theta</span>
      </div>
      <div class="preset" data-preset-id="builtin-alpha" data-band="alpha" data-freq="10">
        <span class="preset-icon">🌿</span><span class="preset-name">Alpha</span>
      </div>
      <div class="preset" data-preset-id="builtin-beta" data-band="beta" data-freq="20">
        <span class="preset-icon">⚡</span><span class="preset-name">Beta</span>
      </div>
      <div class="preset" data-preset-id="builtin-gamma" data-band="gamma" data-freq="40">
        <span class="preset-icon">✨</span><span class="preset-name">Gamma</span>
      </div>
    </div>
    <div class="presets" id="customPresets" aria-label="Presets personalizados"></div>
    <div class="preset-tools">
      <button class="btn btn-mini" id="btnCreatePreset" type="button">＋ Custom</button>
      <button class="btn btn-mini" id="btnOpenTimeline" type="button">⌁ Timeline</button>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Núcleo <span class="hint">moldeo del sonido</span></div>
    <div class="ctrl">
      <div class="ctrl-head">
        <div class="ctrl-label">Brainwave <small>frecuencia objetivo</small></div>
        <div class="ctrl-val" id="valBrainwave">10.0 Hz</div>
      </div>
      <input type="range" id="sliderBrainwave" min="0.5" max="50" step="0.1" value="10">
    </div>
    <div class="ctrl">
      <div class="ctrl-head">
        <div class="ctrl-label">Carrier <small>nota portadora</small></div>
        <div class="ctrl-val" id="valCarrier">200 Hz</div>
      </div>
      <input type="range" id="sliderCarrier" min="20" max="1500" step="1" value="200">
    </div>
  </div>

  <div class="section">
    <div class="section-title">
      Moduladores
      <span class="hint toggle-hint" id="toggleMods" role="button" aria-controls="modsBody" aria-expanded="true">▼</span>
    </div>
    <div id="modsBody" data-folded="false">
      <div class="mod-grid">
        <div class="mod-item">
          <div class="mod-head"><span class="mod-name">a-mod</span><span class="mod-val" id="valAmod">0%</span></div>
          <input type="range" id="sliderAmod" min="0" max="100" value="0">
        </div>
        <div class="mod-item">
          <div class="mod-head"><span class="mod-name">binaural</span><span class="mod-val" id="valBinaural">0%</span></div>
          <input type="range" id="sliderBinaural" min="0" max="100" value="0">
        </div>
        <div class="mod-item">
          <div class="mod-head"><span class="mod-name">stereo</span><span class="mod-val" id="valStereo">0%</span></div>
          <input type="range" id="sliderStereo" min="0" max="100" value="0">
        </div>
        <div class="mod-item">
          <div class="mod-head"><span class="mod-name">f-mod</span><span class="mod-val" id="valFmod">0%</span></div>
          <input type="range" id="sliderFmod" min="0" max="100" value="0">
        </div>
      </div>

      <div class="ctrl ctrl-noise">
        <div class="ctrl-head">
          <div class="ctrl-label">Noise <small>portadora de ruido</small></div>
          <div class="ctrl-val" id="valNoise">0%</div>
        </div>
        <input type="range" class="teal" id="sliderNoise" min="0" max="100" value="0">
      </div>
    </div>
  </div>
</aside>
