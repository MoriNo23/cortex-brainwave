---
import AppLayout from '../layouts/AppLayout.astro';
import Header from '../components/Header.astro';
import LeftPanel from '../components/LeftPanel.astro';
import BrainVisuals from '../components/BrainVisuals.astro';
import RightPanel from '../components/RightPanel.astro';
import TimelineDock from '../components/TimelineDock.astro';
import StatusBar from '../components/StatusBar.astro';
import PresetDialog from '../components/PresetDialog.astro';
import Toast from '../components/Toast.astro';
import '../styles/cortex-redesign.css';
---

<AppLayout title="Cortex · Astro Rebuild" description="Rediseño Astro del generador Cortex con timeline, audio reactivo y luz estroboscópica.">
  <div class="app">
    <Header />

    <div class="main">
      <LeftPanel />
      <BrainVisuals />
      <RightPanel />
    </div>

    <TimelineDock />
    <StatusBar />
  </div>

  <Toast />
  <PresetDialog />

  <script>
    import '../scripts/cortex-app.js';
  </script>
</AppLayout>
