+    state.dockExpanded = Boolean(raw.dockExpanded);
+    state.stopBehavior = normalizeStopBehavior(raw.stopBehavior);
+  } catch (error) {
+    state.dockExpanded = false;
+    state.stopBehavior = { ...STOP_BEHAVIOR_DEFAULTS };
+  }
+}
+
+function persistUiPreferences() {
+  try {
+    let raw = {};
+    try { raw = JSON.parse(localStorage.getItem('cortex-settings')) || {}; } catch (error) { raw = {}; }
+    raw.dockExpanded = Boolean(state.dockExpanded);
+    raw.stopBehavior = normalizeStopBehavior(state.stopBehavior);
