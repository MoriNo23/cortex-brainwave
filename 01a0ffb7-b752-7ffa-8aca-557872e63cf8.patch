+
+export const AVAILABLE_EMOTES = ['🌙','🌀','🌿','⚡','✨','🧘','🎯','🌊','🎵','🧠','☁️','🌌','😴','🚀'];
+export const AUDIO_KEYS = ['brainwave','carrier','amod','binaural','stereo','fmod','noise','mix'];
