+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const horizontal = callsOf(radarCtx(), 'ellipse').find(c => c[3] > c[4] + 10);
+  if (!horizontal) throw new Error('sin banda horizontal');
+  await wait(80);
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const dot = callsOf(radarCtx(), 'arc').find(c => c[3] === 4);
+  if (!dot || Math.abs(dot[1] - 160) < 0.5) throw new Error('punto no osciló');
+}},
+{ group: 'OpenSpec scenarios', name: '[spec/radar/fmod] fmod activo → banda V + punto oscila', spec: 'radar/fmod', fn: async () => {
+  setMods({ playing: true, fmod: 80, brainwave: 10 });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const vertical = callsOf(radarCtx(), 'ellipse').find(c => c[3] < c[4] * 0.55 && c[4] > 100);
+  if (!vertical) throw new Error('sin banda vertical');
+}},
+{ group: 'OpenSpec scenarios', name: '[spec/radar/binaural] binaural activo → 2 lóbulos', spec: 'radar/binaural', fn: () => {
+  setMods({ playing: true, binaural: 80 });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const lobes = callsOf(radarCtx(), 'ellipse').filter(c => Math.abs(c[2] - 160) < 5 && c[3] < 60);
+  if (lobes.length < 2) throw new Error('lóbulos: ' + lobes.length);
+}},
+{ group: 'OpenSpec scenarios', name: '[spec/radar/stopped] detenido → punto centrado', spec: 'radar/stopped', fn: () => {
+  setMods({ playing: false, stereo: 80, fmod: 80, binaural: 80 });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const dot = callsOf(radarCtx(), 'arc').find(c => c[3] === 4);
+  if (!dot || dot[1] !== 160 || dot[2] !== 160)
+    throw new Error('punto no centrado en detenido');
+}},
+{ group: 'OpenSpec scenarios', name: '[spec/readout/none] sin modulación → texto correcto', spec: 'readout/none', fn: () => {
+  setMods({ stereo:0, fmod:0, binaural:0, amod:0, noise:0 });
+  C().audio.updateSpatialReadout();
+  if (!$('#spatialReadout').textContent.includes('Sin modulación espacial'))
+    throw new Error('falta el texto esperado');
+}},
+
+/* ── TRANSICIONES DEL TIMELINE (spec timeline-transitions) ── */
+{ group: 'Timeline · transiciones', name: 'interpolateAudioState: 0 = origen, 1 = destino, 0.5 = media', fn: () => {
+  const C = frameWin.__CORTEX__;
+  const a = { brainwave:2, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 };
+  const z = { brainwave:40, carrier:400, amod:50, binaural:50, stereo:0, fmod:0, noise:0, mix:40 };
+  const p0 = C.audio.interpolateAudioState(a, z, 0);
+  const p1 = C.audio.interpolateAudioState(a, z, 1);
+  const ph = C.audio.interpolateAudioState(a, z, 0.5);
+  if (p0.brainwave !== 2 || p0.carrier !== 200 || p0.mix !== 80) throw new Error('progreso 0 ≠ origen');
+  if (p1.brainwave !== 40 || p1.carrier !== 400 || p1.mix !== 40) throw new Error('progreso 1 ≠ destino');
+  if (Math.abs(ph.brainwave - 21) > 1e-9 || Math.abs(ph.carrier - 300) > 1e-9 || Math.abs(ph.mix - 60) > 1e-9)
+    throw new Error('progreso 0.5 ≠ media');
+}},
+{ group: 'Timeline · transiciones', name: 'interpolateAudioState recorta el progreso fuera de rango', fn: () => {
+  const C = frameWin.__CORTEX__;
+  const a = { brainwave:2, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 };
+  const z = { brainwave:40, carrier:400, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:40 };
+  if (C.audio.interpolateAudioState(a, z, 7).brainwave !== 40) throw new Error('progreso 7 no recorta a 1');
+  if (C.audio.interpolateAudioState(a, z, -3).brainwave !== 2) throw new Error('progreso -3 no recorta a 0');
+}},
+{ group: 'Timeline · transiciones', name: 'unidades: 2 min → 120 s y 90 s → 1.5 min', fn: () => {
+  const C = frameWin.__CORTEX__;
+  if (C.timeline.durationToSeconds('2', 'min', 'step') !== 120) throw new Error('2 min ≠ 120 s');
+  if (C.timeline.secondsToDuration(90, 'min') !== '1.5') throw new Error('90 s ≠ 1.5 min');
+  if (C.timeline.durationToSeconds('0.001', 'min', 'step') !== 1) throw new Error('paso bajo el mínimo no recorta a 1');
+  if (C.settings.clampTransitionSeconds(500) !== 60) throw new Error('transición sobre 60 no recorta');
+  if (C.settings.clampTransitionSeconds(0.5) !== 0.5) throw new Error('transición 0.5 válida');
+}},
+{ group: 'Timeline · transiciones', name: 'hint de duración muestra el equivalente en la otra unidad', fn: () => {
+  const C = frameWin.__CORTEX__;
+  const hintMin = C.timeline.durationHint(4, 'min');
+  const hintS = C.timeline.durationHint(120, 's');
+  if (!hintMin.includes('4 s')) throw new Error('hint en min: ' + hintMin);
+  if (!hintS.includes('2 min')) throw new Error('hint en s: ' + hintS);
+}},
+{ group: 'Timeline · transiciones', name: 'transición por omisión: 2 s activada; legacy sin campos', fn: () => {
+  const C = frameWin.__CORTEX__;
+  frameWin.localStorage.setItem('cortex-timeline-v1', JSON.stringify({
+    steps: [{ id:'x', presetId:'b', durationSeconds: 30, snapshot:{ brainwave:10, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'A', emoji:'a', band:'alpha' }]
+  }));
+  C.loadTimelineData();
+  if (C.session.timelineState.transition.enabled !== true) throw new Error('legacy no activa la transición');
+  if (C.session.timelineState.transition.seconds !== 2) throw new Error('legacy no usa 2 s');
+  if (C.session.timelineState.durationUnits.step !== 's') throw new Error('legacy no usa segundos');
+  if (C.session.timelineState.steps.length !== 1) throw new Error('legacy perdió el paso');
+}},
+{ group: 'Timeline · transiciones', name: 'transición desactivada aplica el preset directo', fn: async () => {
+  const C = frameWin.__CORTEX__;
+  C.session.timelineState.steps = [
+    { id:'s1', presetId:'b', durationSeconds:2, snapshot:{ brainwave:2, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'D', emoji:'d', band:'delta' }
+  ];
+  C.session.timelineState.loop = false;
+  C.session.timelineState.transition.enabled = false;
+  setMods({ brainwave: 10 });
+  const p = C.session.getTimelinePlayer();
+  p.play();
+  await wait(150);
+  if (C.session.state.brainwave !== 2) throw new Error('corte directo no aplicó 2 Hz: ' + C.session.state.brainwave);
+  p.stop();
+}},
+{ group: 'Timeline · transiciones', name: 'rampa: el progreso sale del reloj de audio (tiempo simulado en mock)', fn: () => {
+  // El mock de esta página congela ctx.currentTime en 0, así que la rampa se
+  // prueba anclando su inicio hacia atrás: 1 s de una rampa de 2 s = progreso
+  // 0.5. El timing real con reloj vivo lo cubre tests/timeline-transitions.cjs.
+  const C = frameWin.__CORTEX__;
+  C.session.timelineState.steps = [
+    { id:'s1', presetId:'b', durationSeconds:3, snapshot:{ brainwave:2, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'D', emoji:'d', band:'delta' }
+  ];
+  C.session.timelineState.loop = false;
+  C.session.timelineState.transition.enabled = true;
+  C.session.timelineState.transition.seconds = 2;
+  setMods({ brainwave: 10 });
+  const p = C.session.getTimelinePlayer();
+  p.play();
+  p.transitionStartedAt = p.clockNow() - 1;   // 1 s consumido de 2 s
+  p.applyTransitionProgress();
+  const mid = C.session.state.brainwave;
+  if (mid <= 2.2 || mid >= 9.8) throw new Error('sin estado intermedio: ' + mid);
+  p.transitionStartedAt = p.clockNow() - 2;   // rampa vencida
+  p.applyTransitionProgress();
+  if (Math.abs(C.session.state.brainwave - 2) > 0.05) throw new Error('no converge a 2 Hz: ' + C.session.state.brainwave);
+  if (p.transitionDone !== true) throw new Error('la rampa no quedó marcada como terminada');
+  p.stop();
+}},
+
+/* ── TIMELINE · DOCK ──
+   El timeline ya no es un modal: los casos de popup (Escape, cierre, foco)
+   dejan de aplicar y se reemplazan por el comportamiento del dock fijo. */
+{ group: 'Timeline · dock', name: 'sin modal: el dialog desapareció y la pista vive abajo', fn: () => {
+  if (frameDoc.getElementById('timelineDialog')) throw new Error('el dialog del timeline sigue en el DOM');
+  if (!frameDoc.getElementById('dockClips')) throw new Error('la pista del dock no existe');
+  if (frameDoc.getElementById('timelineDock').dataset.dockState !== 'collapsed' && frameDoc.getElementById('timelineDock').dataset.dockState !== 'expanded') throw new Error('el dock no declara su estado');
+}},
+{ group: 'Timeline · dock', name: 'plegar/desplegar: el botón alterna el estado y persiste la preferencia', fn: async () => {
+  const btn = frameDoc.getElementById('btnOpenTimeline');
+  if (C().session.state.dockExpanded) btn.click();   // partir plegado
+  await nextFrame();
+  btn.click();
+  await nextFrame();
+  if (C().session.state.dockExpanded !== true) throw new Error('el click no desplegó');
+  if (frameDoc.getElementById('timelineDock').dataset.dockState !== 'expanded') throw new Error('data-dock-state no cambió');
+  if (btn.getAttribute('aria-expanded') !== 'true') throw new Error('aria-expanded no se actualizó');
+  const saved = JSON.parse(frameWin.localStorage.getItem('cortex-settings') || '{}');
+  if (saved.dockExpanded !== true) throw new Error('la preferencia no quedó en cortex-settings');
+  btn.click();
+  await nextFrame();
+  if (C().session.state.dockExpanded !== false) throw new Error('el click no plegó');
+  const saved2 = JSON.parse(frameWin.localStorage.getItem('cortex-settings') || '{}');
+  if (saved2.dockExpanded !== false) throw new Error('la preferencia plegada no se guardó');
+}},
+{ group: 'Timeline · dock', name: 'selección por click: un clip resaltado y el inspector con sus datos', fn: async () => {
+  const C = frameWin.__CORTEX__;
+  C.session.timelineState.steps = [
+    { id:'d1', presetId:'b', durationSeconds:10, snapshot:{ brainwave:2, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'Delta', emoji:'d', band:'delta' },
+    { id:'t1', presetId:'b', durationSeconds:20, snapshot:{ brainwave:6, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'Theta', emoji:'t', band:'theta' },
+    { id:'a1', presetId:'b', durationSeconds:30, snapshot:{ brainwave:10, carrier:200, amod:0, binaural:0, stereo:0, fmod:0, noise:0, mix:80 }, name:'Alpha', emoji:'a', band:'alpha' },
+  ];
+  C.timeline.renderTimeline();
+  $$('.dock-clip-btn')[0].click();
+  await nextFrame();
+  if ($$('.dock-clip.selected').length !== 1) throw new Error('no quedó exactamente un clip seleccionado');
+  const inspector = frameDoc.getElementById('dockInspector');
+  if (inspector.hidden) throw new Error('el inspector no se abrió');
+  if (!frameDoc.getElementById('inspectorName').textContent.includes('Delta')) throw new Error('el inspector no muestra el nombre');
+  if (frameDoc.getElementById('inspectorDuration').value !== '10') throw new Error('la duración no se ve en segundos: ' + frameDoc.getElementById('inspectorDuration').value);
+}},
+{ group: 'Timeline · dock', name: 'proporcionalidad: 10/20/30 s se ven como 1:2:3 con piso legible', fn: async () => {
+  if (!C().session.state.dockExpanded) frameDoc.getElementById('btnOpenTimeline').click();
+  await nextFrame();
+  const widths = $$('.dock-clip').map(el => el.offsetWidth);
+  if (widths.length !== 3) throw new Error('esperaba 3 clips, hay ' + widths.length);
+  if (!(widths[2] > widths[1] && widths[1] > widths[0])) throw new Error('sin orden 10<20<30: ' + widths.join(','));
+  const ratio = widths[2] / widths[0];
+  if (Math.abs(ratio - 3) > 0.6) throw new Error('proporción 30/10 lejana de 3: ' + ratio.toFixed(2));
+  if (widths[0] < 44) throw new Error('clip por debajo del ancho mínimo: ' + widths[0]);
+  const chips = $$('.dock-clip .dock-clip-chip').map(el => el.textContent.trim());
+  if (chips.join('|') !== '10 s|20 s|30 s') throw new Error('chips: ' + chips.join('|'));
+}},
+{ group: 'Timeline · dock', name: 'doble click aplica el preset del clip', fn: () => {
+  $$('.dock-clip-btn')[0].dispatchEvent(new frameWin.MouseEvent('dblclick', { bubbles: true }));
+  if (C().session.state.brainwave !== 2) throw new Error('el doble click no aplicó el snapshot (delta = 2 Hz): ' + C().session.state.brainwave);
+}},
+{ group: 'Timeline · dock', name: 'editar la duración en el inspector actualiza y persiste', fn: async () => {
+  $$('.dock-clip-btn')[0].click();
+  await nextFrame();
+  const input = frameDoc.getElementById('inspectorDuration');
+  input.value = '90';
+  input.dispatchEvent(new frameWin.Event('change', { bubbles: true }));
+  await nextFrame();
+  if (C().session.timelineState.steps[0].durationSeconds !== 90) throw new Error('la duración guardada no es 90 s');
+  const chip = $$('.dock-clip .dock-clip-chip')[0].textContent.trim();
+  if (chip !== '90 s') throw new Error('el chip no se actualizó: ' + chip);
+}},
+
+];
+
+/* ═══════════════════════════════════════════════════════════════
+   5. RUNNER
+   ═══════════════════════════════════════════════════════════════ */
+async function runAllTests() {
+  const btn = document.getElementById('btnRun');
+  btn.disabled = true;
+  document.getElementById('report').innerHTML = '';
+  const t0 = performance.now();
+
+  const groups = new Map();
+  for (const t of TESTS) {
+    if (!groups.has(t.group)) groups.set(t.group, []);
+    groups.get(t.group).push(t);
+  }
+
+  let pass = 0, fail = 0;
+
+  for (const [groupName, tests] of groups) {
+    const groupEl = document.createElement('div');
+    groupEl.className = 'group';
+    const head = document.createElement('div');
+    head.className = 'group-head';
+    head.innerHTML = `<span>${groupName}</span><span class="counts"></span>`;
+    groupEl.appendChild(head);
+
+    let gp = 0, gf = 0;
+
+    for (const t of tests) {
+      const testEl = document.createElement('div');
+      testEl.className = 'test';
+      const specTag = t.spec ? `<span class="spec">[${t.spec}]</span>` : '';
+      try {
+        await t.fn();
+        testEl.classList.add('pass');
+        testEl.innerHTML = `${t.name} ${specTag}`;
+        gp++; pass++;
+      } catch (e) {
+        testEl.classList.add('fail');
+        testEl.innerHTML = `${t.name} ${specTag}<div class="msg">${e.message || e}</div>`;
+        gf++; fail++;
+      }
+      groupEl.appendChild(testEl);
+    }
+
+    head.querySelector('.counts').innerHTML =
+      `<span class="pass">${gp}✓</span>${gf ? ` <span class="fail">${gf}✗</span>` : ''}`;
+    document.getElementById('report').appendChild(groupEl);
+  }
+
+  const elapsed = (performance.now() - t0).toFixed(0);
+  const summary = document.createElement('div');
+  summary.className = 'summary ' + (fail === 0 ? 'pass' : 'fail');
+  summary.innerHTML = `
+    <strong>${pass + fail} tests ejecutados en ${elapsed}ms</strong><br>
+    ${pass}✓ pasaron · ${fail}✗ fallaron<br>
+    <span style="color:#6B6358;font-size:11px">
+      ${fail === 0 ? 'Todos los escenarios OpenSpec verificados.' : 'Revisar los tests marcados en rojo.'}
+    </span>
+  `;
+  document.getElementById('report').appendChild(summary);
+
+  btn.disabled = false;
+}
+
+/* Auto-load on open */
+loadApp();
+</script>
+</body>
+</html>
