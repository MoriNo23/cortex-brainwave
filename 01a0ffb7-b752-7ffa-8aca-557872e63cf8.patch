+  const srcs = ['carrierOsc','amLfo','binOscL','binOscR','stereoOsc','stereoLfo','fmLfo','noiseSourceL','noiseSourceR'];
+  const missing = srcs.filter(k => !C().audio.engine.nodes[k]._started);
+  if (missing.length) throw new Error('sin start: ' + missing.join(', '));
+}},
+{ group: 'Motor de audio', name: 'Todas las fuentes tienen .stop() tras stop', fn: () => {
+  C().audio.engine.stop();
+  const srcs = ['carrierOsc','amLfo','binOscL','binOscR','stereoOsc','stereoLfo','fmLfo','noiseSourceL','noiseSourceR'];
+  const missing = srcs.filter(k => !C().audio.engine.nodes[k]._stopped);
+  if (missing.length) throw new Error('sin stop: ' + missing.join(', '));
+  setMods(); C().audio.engine.start(); // dejar corriendo
+}},
+{ group: 'Motor de audio', name: 'start → stop → start reconstruye fuentes', spec: 'audio/restart', fn: () => {
+  const e = C().audio.engine;
+  if (!e.started) e.start();
+  const first = e.nodes.carrierOsc;
+  e.stop();
+  if (!first._stopped) throw new Error('la primera fuente no quedó detenida');
+  e.start();
+  const second = e.nodes.carrierOsc;
+  if (first === second) throw new Error('se reutilizó un OscillatorNode detenido');
+  if (!e.started) throw new Error('la segunda sesión no inició');
+}},
