diff --git a/src/styles/cortex-redesign.css b/src/styles/cortex-redesign.css
new file mode 100644
index 0000000..1603a56
--- /dev/null
+++ b/src/styles/cortex-redesign.css
@@ -0,0 +1,591 @@
+  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@400;600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap');
+
+* { margin:0; padding:0; box-sizing:border-box; }
+
+:root {
+  --bg: #070b14;
+  --bg-2: #0e1526;
+  --panel: rgba(17, 24, 39, 0.84);
+  --panel-strong: rgba(10, 14, 25, 0.94);
+  --line: rgba(125, 145, 183, 0.14);
+  --line-2: rgba(125, 145, 183, 0.25);
+  --text: #edf4ff;
+  --text-dim: #b6c2df;
+  --text-mute: #74809e;
+  --amber: #ffbe6b;
+  --amber-dim: #d99242;
+  --teal: #64d2c8;
+  --teal-dim: #367e7a;
+  --red: #ff7a7a;
+  --shadow: 0 24px 80px rgba(3, 7, 18, 0.45);
+  /* Acento por banda: los clips del dock del timeline los usan para
+     comunicar de qué onda se trata sin leer el nombre. */
+  --band-delta: #87a0ff;
+  --band-theta: #c18fff;
+  --band-alpha: #ffbe6b;
+  --band-beta: #83da89;
+  --band-gamma: #64d2c8;
+}
+
+html, body {
+  height: 100%;
+  background:
+    radial-gradient(circle at top, rgba(100,210,200,0.14), transparent 28%),
+    radial-gradient(circle at 20% 20%, rgba(255,190,107,0.12), transparent 20%),
+    linear-gradient(180deg, #04070e 0%, #09111f 100%);
+  color: var(--text);
+  font-family: 'Inter', system-ui, sans-serif;
+  font-size: 14px;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  overflow: hidden;
+}
+
+body::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
