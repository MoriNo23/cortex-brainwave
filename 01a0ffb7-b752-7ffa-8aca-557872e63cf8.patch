+    this.pausedRemainingMs = 0;
+    this.pausedTransitionMs = 0;
+    this.frozenRemainingMs = 0;
+    this.stalled = false;
+    this.index = 0;
+    this.stepStartedAt = 0;
+    this.boundaryAt = 0;
+    this.transitionMs = 0;
+    this.transitionDone = true;
+    this.sourceState = null;
+    this.targetState = null;
