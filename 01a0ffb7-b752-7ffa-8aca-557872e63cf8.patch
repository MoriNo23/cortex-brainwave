+  if (timelineState.durationUnits[context] === normalized) return;
+  timelineState.durationUnits[context] = normalized;
+  persistTimeline();
+  renderDurationUnitButtons(context);
+  if (context === 'step') renderTimeline();
+  else renderTransitionControls();
