+    this.carrierOsc = ctx.createOscillator();
+    this.carrierOsc.type = 'sine';
+    this.carrierOsc.frequency.value = state.carrier;
+    this.carrierGain = ctx.createGain();
+    this.carrierGain.gain.value = 0.25;
