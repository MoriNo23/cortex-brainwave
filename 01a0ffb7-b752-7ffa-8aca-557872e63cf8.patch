+/* ── RADAR — ANTI-REGRESIÓN (bug del usuario) ── */
+{ group: 'Radar · anti-regresión', name: 'stereo=80 dibuja banda horizontal (radioX > radioY)', spec: 'radar/stereo', fn: () => {
+  setMods({ stereo: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  const horizontal = ell.find(c => c[3] > c[4] + 10); // radiusX > radiusY
+  if (!horizontal) throw new Error('no se dibujó banda horizontal (rx>ry)');
+}},
+{ group: 'Radar · anti-regresión', name: 'fmod=80 dibuja banda vertical (radioX << radioY)', spec: 'radar/fmod', fn: () => {
+  setMods({ fmod: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  // buscar una elipse que no sea el contorno de la cabeza: su radiusY debe ser ≈ headRy
+  // y su radiusX mucho menor. En la práctica: buscar ellipse con rx < ry * 0.5
+  const vertical = ell.find(c => c[3] < c[4] * 0.55 && c[4] > 100);
+  if (!vertical) throw new Error('no se dibujó banda vertical angosta');
+}},
+{ group: 'Radar · anti-regresión', name: 'binaural=80 dibuja 2 lóbulos en oídos', spec: 'radar/binaural', fn: () => {
+  setMods({ binaural: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  // Excluir cabeza/anillos: los lóbulos son pequeños y están separados del centro.
+  const lobes = ell.filter(c => Math.abs(c[2] - 160) < 5 && Math.abs(c[1] - 160) > 35 && c[3] > 15 && c[3] < 60);
+  if (lobes.length !== 2) throw new Error('esperados 2 lóbulos, obtenidos ' + lobes.length);
+  if (Math.abs((lobes[0][1] + lobes[1][1]) - 320) > 1)
+    throw new Error('lóbulos no simétricos');
+}},
+{ group: 'Radar · anti-regresión', name: 'noise=80 dibuja ≥8 arcos difusos', spec: 'radar/noise', fn: () => {
+  setMods({ noise: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const arcs = callsOf(radarCtx(), 'arc');
+  if (arcs.length < 8) throw new Error('solo ' + arcs.length + ' arcos');
+}},
+{ group: 'Radar · anti-regresión', name: 'amod=80 dibuja anillo pulsante', spec: 'radar/amod', fn: () => {
+  setMods({ amod: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  // el anillo de a-mod tiene rx/ry menores al outline pero mayores a los rings
+  const ring = ell.find(c => c[3] > 80 && c[3] < 130 && Math.abs(c[3]/c[4] - 0.74/0.92) < 0.1);
+  if (!ring) throw new Error('no se dibujó anillo de a-mod');
+}},
+{ group: 'Radar · anti-regresión', name: 'Sin moduladores → solo dibujo base (cabeza + 3 rings + ejes)', spec: 'radar/base', fn: () => {
+  setMods({ stereo: 0, fmod: 0, binaural: 0, amod: 0, noise: 0 });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  // 3 rings + 1 cabeza = 4 elipses base
+  if (ell.length > 6) throw new Error('demasiadas elipses en estado base: ' + ell.length);
+}},
+{ group: 'Radar · anti-regresión', name: 'detenido no dibuja campos dinámicos', spec: 'radar/stopped', fn: () => {
+  setMods({ stereo: 80, fmod: 80, binaural: 80, amod: 80, noise: 80, playing: false });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const ell = callsOf(radarCtx(), 'ellipse');
+  const arcs = callsOf(radarCtx(), 'arc');
+  // Solo quedan 3 anillos + contorno; el marcador centrado puede seguir dibujándose.
+  if (ell.length !== 6) throw new Error('se dibujaron campos detenidos: ' + ell.length + ' elipses');
+  if (arcs.length > 3) throw new Error('se dibujó nube dinámica detenida: ' + arcs.length + ' arcos');
+}},
+{ group: 'Radar · anti-regresión', name: 'Cambiar stereo DEBE cambiar el dibujo (bug original)', spec: 'radar/stereo', fn: () => {
+  setMods({ stereo: 0, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const before = callsOf(radarCtx(), 'ellipse').length;
+
+  setMods({ stereo: 80, playing: true });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const after = callsOf(radarCtx(), 'ellipse').length;
+
+  if (after <= before) throw new Error('stereo no agregó ninguna elipse al dibujo (regresión)');
+}},
+
+/* ── RADAR — PUNTO FUENTE ── */
+{ group: 'Radar · punto fuente', name: 'playing=false → punto en centro exacto', spec: 'radar/stopped', fn: () => {
+  setMods({ playing: false, stereo: 80, fmod: 80 });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  const arcs = callsOf(radarCtx(), 'arc');
+  // el punto fuente es un arc con radio 4. Su centro debe ser (160, 160)
+  const dot = arcs.find(c => c[3] === 4);
+  if (!dot) throw new Error('no se encontró el punto fuente');
+  if (dot[1] !== 160 || dot[2] !== 160)
+    throw new Error('punto en (' + dot[1] + ',' + dot[2] + '), esperado (160,160)');
+}},
+{ group: 'Radar · punto fuente', name: 'playing=true + stereo=80 → punto se mueve en X', spec: 'radar/stereo', fn: async () => {
+  setMods({ playing: true, stereo: 80, brainwave: 10 });
+  // 3 muestras con delay para garantizar que la fase cambie
+  const xs = [];
+  for (let i = 0; i < 3; i++) {
+    resetDrawLog();
+    C().visualizers.drawRadarFrame();
+    const dot = callsOf(radarCtx(), 'arc').find(c => c[3] === 4);
+    if (dot) xs.push(dot[1]);
+    await wait(60);
+  }
+  const allCenter = xs.every(x => Math.abs(x - 160) < 0.5);
+  if (allCenter) throw new Error('el punto nunca se movió de X=160');
+}},
+{ group: 'Radar · punto fuente', name: 'playing=true + fmod=80 → punto se mueve en Y', spec: 'radar/fmod', fn: async () => {
+  setMods({ playing: true, fmod: 80, brainwave: 10 });
+  const ys = [];
+  for (let i = 0; i < 3; i++) {
+    resetDrawLog();
+    C().visualizers.drawRadarFrame();
+    const dot = callsOf(radarCtx(), 'arc').find(c => c[3] === 4);
+    if (dot) ys.push(dot[2]);
+    await wait(60);
+  }
+  const allCenter = ys.every(y => Math.abs(y - 160) < 0.5);
+  if (allCenter) throw new Error('el punto nunca se movió de Y=160');
+}},
+{ group: 'Radar · punto fuente', name: 'playing=false → punto gris (no ámbar)', spec: 'radar/stopped', fn: () => {
+  setMods({ playing: false });
+  resetDrawLog();
+  C().visualizers.drawRadarFrame();
+  // el último arc con radio 4 es el punto fuente
+  const arcs = callsOf(radarCtx(), 'arc');
+  const dot = arcs.find(c => c[3] === 4);
+  if (!dot) throw new Error('no se encontró el punto');
+  // El fillStyle se registra en la llamada a fill() que sigue
+  const fillCalls = callsOf(radarCtx(), 'fill');
+  // Validación blanda: al menos llamó fill() después de dibujar el punto
+  if (fillCalls.length === 0) throw new Error('sin fill() tras el punto');
+}},
